# Copy this file to .env and adjust values for your machine.

HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.31
HERMES_DATA_DIR=./data
# iCloud Obsidian Documents parent (contains per-user vault folders).
# Host path must be a real directory, not a symlink, so the nested bind works.
# OBSIDIAN_VAULTS_HOST_PATH=/Users/you/Library/Mobile Documents/iCloud~md~obsidian/Documents
HERMES_UID=1000
HERMES_GID=1000
HERMES_DASHBOARD_PORT=9119
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Honcho (self-hosted memory). Image tag can be pinned after first pull.
HONCHO_IMAGE=ghcr.io/plastic-labs/honcho:latest
HONCHO_API_PORT=8000
# Deriver/dialectic/embeddings require an LLM. Copy a working OpenAI-compatible
# key into LLM_OPENAI_API_KEY (do not commit .env). Local mapping: OpenRouter
# (data/.env OPENROUTER_API_KEY) because the OpenAI key has no credits.
LLM_OPENAI_API_KEY=
DERIVER_MODEL_CONFIG__MODEL=openai/gpt-5.4-mini
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
SUMMARY_MODEL_CONFIG__MODEL=openai/gpt-5.4-mini
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=openai/gpt-5.4-mini
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DREAM_INDUCTION_MODEL_CONFIG__MODEL=openai/gpt-5.4-mini
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=openai/text-embedding-3-small
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=openai/gpt-5.4-mini
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=openai/gpt-5.4-mini
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=openai/gpt-5.4-mini
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=openai/gpt-5.4-mini
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=openai/gpt-5.4-mini
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=https://openrouter.ai/api/v1
# If the chat provider has no embeddings, split embed vs chat:
# EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL_CONFIG__OVERRIDES__API_KEY_ENV=LLM_OPENAI_API_KEY
# Conversation title cascade uses Hermes provider auth via hermes-auxiliary-bridge
# (xai-oauth/grok-4.3 → openai-codex/gpt-5.4-mini → Hermes completeChat fallback)
APPLE_CALDAV_URL=https://caldav.icloud.com
APPLE_CALDAV_USERNAME=
APPLE_CALDAV_APP_PASSWORD=
CALDAV_MCP_BEARER_TOKEN=
APPLE_MCP_BEARER_TOKEN=replace-with-same-token-as-apple-mcp-app
# Deprecated fallback for one release; use APPLE_MCP_BEARER_TOKEN instead
REMINDERS_MCP_BEARER_TOKEN=
# Must match API_SERVER_KEY in ${HERMES_DATA_DIR}/.env if that file sets one —
# Hermes v0.21 loads data/.env with override=True, so compose change-me would 401.
HERMES_API_SERVER_KEY=change-me
MESSAGING_API_PORT=3000
MESSAGING_API_JWT_SECRET=change-me
MESSAGING_API_HOST=100.x.x.x:3000
INVITE_EXPIRY_HOURS=48
MIN_PASSWORD_LENGTH=12
COMPANION_MCP_BEARER_TOKEN=replace-with-long-random-token
# Companion Grok gateway on the Mac (messaging-api is the only HTTP client).
GROK_GATEWAY_URL=http://host.docker.internal:3030
GROK_GATEWAY_TOKEN=
CRON_WEBHOOK_BEARER=replace-with-long-random-token
CRON_OUTPUT_DIR=/opt/data/cron/output
CRON_OUTPUT_POLL_MS=5
ADDRESS_ENRICHMENT_SESSION_ID=companion-address-enrichment
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=/opt/data/apns/AuthKey_XXXXXX.p8
APNS_ENVIRONMENT=development
PUSH_PREVIEW_MAX_CHARS=120
# SYNC_INBOX_MAX_GAP=500
# Photo attachments (v2.8.0)
ATTACHMENTS_DIR=/opt/data/attachments
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_ORPHAN_TTL_HOURS=24
VISION_MAX_EDGE_PX=1536
THUMB_MAX_EDGE_PX=200
VISION_HISTORY_MAX_BYTES=8388608

HERMES_DASHBOARD_URL=http://hermes-gateway:9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
